{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Sources": {
    "FootballDataOrg": {
      "ApiKey": "PUT_YOUR_FREE_FOOTBALL_DATA_ORG_KEY_HERE"
    }
  },

  "Fcm": {
    "ServiceAccountPath": "./firebase-service-account.json"
  },

  "Sync": {
    "LiveIntervalSeconds": 45,
    "IdleIntervalSeconds": 3600,
    "PerLeagueDelayMs": 6500
  }
}
